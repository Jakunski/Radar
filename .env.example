# Copie este arquivo para ".env" (sem o .example) e preencha com as chaves
# do SEU projeto Firebase — veja o passo a passo no README.md.
# Esse arquivo é só para rodar o site no seu computador (npm run dev).
# Para publicar no GitHub Pages, as mesmas chaves vão em
# Settings > Secrets and variables > Actions, no repositório do GitHub.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
